{
  // This folder is nested inside the "root" workspace-folder entry
  // (ai-gaussian-splatter.code-workspace, path "."), whose own Biome
  // session already covers the whole repo tree, including frontend/.
  // Without this, biome-vscode starts a second session here that
  // overlaps with root's, duplicating coverage of the same files —
  // the exact "Biome started multiple sessions for some of the same
  // files" warning this setting exists to avoid.
  "biome.enabled": false
}
