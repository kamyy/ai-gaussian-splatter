# Local dev config for both services, kept in one file so a var's home is unambiguous. Nothing here is loaded
# automatically — copy the vars each service needs into its own untracked .env:
#   SHARED + WEB    -> web/.env
#   SHARED + WORKER -> worker/.env
# SHARED vars are copied verbatim except APP_PUBLIC_URL, which needs a different value in each file — see its comment.
# Keep the section banners in both copies: they are what makes a var's home still obvious once it is sitting in a file
# that mixes both sections.
# `worker/.env` is loaded whole into the worker container via `podman run --env-file` (RUNBOOK.md), so don't paste
# WEB-only secrets into it — the container has no use for Clerk or database credentials and doesn't need the exposure.

# ======================================================================================================================
# SHARED — same name and usually the same value in both files
# ======================================================================================================================

# The two dev buckets from "Dev AWS resources" in RUNBOOK.md.
UPLOADS_BUCKET=ai-gaussian-splatter-dev-uploads
SPLATS_BUCKET=ai-gaussian-splatter-dev-splats

# The dev IAM user scoped to the two buckets above — replace both with the key pair `aws iam create-access-key`
# returned when RUNBOOK.md created it. Kept here rather than in ~/.aws/credentials because both `next dev` and the
# worker container load these directly, and because the SDK's env provider tests these for truthiness: an empty value
# counts as absent and the chain falls through to ~/.aws/credentials, signing with whatever profile is configured
# there. The placeholders are non-empty so an unedited file fails with a 403 instead of quietly using an admin
# profile.
AWS_ACCESS_KEY_ID=replace-with-dev-user-key
AWS_SECRET_ACCESS_KEY=replace-with-dev-user-secret

# Where the worker PATCHes job status back to, and the origin the web app hands the worker at launch. The one var
# whose value differs between the two files: the value below is web/.env's, and worker/.env needs
# http://host.containers.internal:3000 instead. Inside the worker container localhost is the container itself. That
# hostname is Podman's alias for the host running `next dev`. In production both are the same public hostname. With
# nothing listening, status callbacks log a warning and the run continues.
APP_PUBLIC_URL=http://localhost:3000

# ======================================================================================================================
# WEB — web/.env, read by web/lib/server/env.ts unless noted otherwise
# ======================================================================================================================

# The AWS region the SHARED buckets and credentials above are used against — the same value the WORKER section sets
# as AWS_DEFAULT_REGION. It needs two names because the AWS SDK for JavaScript reads only AWS_REGION and boto3 reads
# only AWS_DEFAULT_REGION. web/lib/server/env.ts reads this one and hands it to every S3 and EC2 client explicitly.
AWS_REGION=us-west-2

# Clerk — CLERK_SECRET_KEY also backs server-side session verification (web/lib/server/auth.ts, proxy.ts). Read
# directly off process.env by @clerk/nextjs, not through env.ts.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Points Clerk at the embedded sign-in/sign-up pages under app/. Without these it redirects to its hosted Account
# Portal on accounts.dev instead.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Clerk telemetry is collected from development instances only. The NEXT_PUBLIC_ prefix is required: @clerk/nextjs
# reads this name server-side and also inlines it into the browser bundle.
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1

# Postgres for local dev — the five parts of the connection URL that web/lib/server/databaseUrl.ts reassembles into
# postgresql://. Kept split to match production, where RDS stores its generated credentials as a JSON blob that ECS
# cannot assemble into a URL itself. "Web (frontend + REST API)" in RUNBOOK.md starts the container they address.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ai_gaussian_splatter
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# GPU spot worker launch config, read by web/lib/server/ec2Launcher.ts. Only used when launching a job, which local
# dev never does — but getEnv() runs a single zod safeParse over the whole schema and its first caller is the DB
# pool, so empty values here would fail every DB-backed route. Non-empty placeholders keep the failure on the launch
# path, where it means something.
WORKER_AMI_ID=replace-with-worker-ami-id
WORKER_INSTANCE_TYPE=g5.xlarge
WORKER_SUBNET_ID=replace-with-worker-subnet-id
WORKER_SECURITY_GROUP_ID=replace-with-worker-security-group-id
WORKER_INSTANCE_PROFILE_ARN=replace-with-worker-instance-profile-arn

# Abuse protection — all optional, defaults shown.
RATE_LIMIT_IP_PER_HOUR=5
RATE_LIMIT_USER_PER_DAY=3
GLOBAL_MAX_JOBS_PER_DAY=20
MIN_PHOTOS_PER_SPLAT=20

# ======================================================================================================================
# WORKER — worker/.env, read by worker/pipeline/config.py
# ======================================================================================================================

# The AWS region — the same value the WEB section sets as AWS_REGION. It needs two names because boto3 reads only
# AWS_DEFAULT_REGION and the AWS SDK for JavaScript reads only AWS_REGION. RUNBOOK.md's local pipeline run exports
# this one so its `aws s3 sync` uploads to the same region.
AWS_DEFAULT_REGION=us-west-2

# SPLAT_ID is deliberately absent: it changes every run and is passed with -e on the `podman run` command in
# RUNBOOK.md, not read from this file.
JOB_ID=local-test
CALLBACK_TOKEN=none
FAST_TEST_MODE=false
