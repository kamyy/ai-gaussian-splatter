# Local dev config for both services, kept in one file so a var's home is
# unambiguous. Nothing here is loaded automatically — copy the vars each
# service needs into its own untracked .env:
#   SHARED + WEB    -> web/.env
#   SHARED + WORKER -> worker/.env
# `worker/.env` is loaded whole into the worker container via `podman run
# --env-file` (RUNBOOK.md), so don't paste WEB-only secrets into it — the
# container has no use for Clerk or database credentials and doesn't need the
# exposure.

# ============================================================
# SHARED — read by both web/lib/server/env.ts and worker/pipeline/config.py
# ============================================================

# The two dev buckets from "Development AWS resources" in RUNBOOK.md.
UPLOADS_BUCKET=ai-gaussian-splatter-dev-uploads
SPLATS_BUCKET=ai-gaussian-splatter-dev-splats

# Same region, two names: web/lib/server/env.ts reads AWS_REGION, botocore
# (worker) reads only AWS_DEFAULT_REGION. Set both.
AWS_REGION=us-west-2
AWS_DEFAULT_REGION=us-west-2

# The dev IAM user scoped to the two buckets above — replace both with the
# key pair `aws iam create-access-key` returned when RUNBOOK.md created it.
# Kept here rather than in ~/.aws/credentials because both `next dev` and the
# worker container load these directly, and because the SDK's env provider
# tests these for truthiness: an empty value counts as absent and the chain
# falls through to ~/.aws/credentials, signing with whatever profile is
# configured there. The placeholders are non-empty so an unedited file fails
# with a 403 instead of quietly using an admin profile.
AWS_ACCESS_KEY_ID=replace-with-dev-user-key
AWS_SECRET_ACCESS_KEY=replace-with-dev-user-secret

# ============================================================
# WEB — web/.env, read by web/lib/server/env.ts unless noted otherwise
# ============================================================

# Clerk — CLERK_SECRET_KEY also backs server-side session verification
# (web/lib/server/auth.ts, proxy.ts). Read directly off process.env by
# @clerk/nextjs, not through env.ts.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Points Clerk at the embedded sign-in/sign-up pages under app/. Without these
# it redirects to its hosted Account Portal on accounts.dev instead.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Clerk telemetry is collected from development instances only. The NEXT_PUBLIC_
# prefix is required: @clerk/nextjs reads this name server-side and also inlines
# it into the browser bundle.
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1

# Postgres for local dev — the five parts of the connection URL that
# web/lib/server/databaseUrl.ts reassembles into postgresql://. Kept split to
# match production, where RDS stores its generated credentials as a JSON blob
# that ECS cannot assemble into a URL itself. "Web (frontend + REST API)" in
# RUNBOOK.md starts the container they address.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ai_gaussian_splatter
DATABASE_USER=postgres
DATABASE_PASSWORD=test

# GPU spot worker launch config, read by web/lib/server/ec2Launcher.ts. Only
# used when launching a job, which local dev never does — but getEnv() runs a
# single zod safeParse over the whole schema and its first caller is the DB
# pool, so empty values here would fail every DB-backed route. Non-empty
# placeholders keep the failure on the launch path, where it means something.
WORKER_AMI_ID=replace-with-worker-ami-id
WORKER_INSTANCE_TYPE=g5.xlarge
WORKER_SUBNET_ID=replace-with-worker-subnet-id
WORKER_SECURITY_GROUP_ID=replace-with-worker-security-group-id
WORKER_INSTANCE_PROFILE_ARN=replace-with-worker-instance-profile-arn

# Abuse protection — all optional, defaults shown.
RATE_LIMIT_IP_PER_HOUR=5
RATE_LIMIT_USER_PER_DAY=3
GLOBAL_MAX_JOBS_PER_DAY=20
MIN_PHOTOS_PER_SPLAT=20

# Where the worker PATCHes job status back to. Must be reachable from EC2.
APP_PUBLIC_URL=http://localhost:3000

# ============================================================
# WORKER — worker/.env, read by worker/pipeline/config.py
# ============================================================

# SPLAT_ID is deliberately absent: it changes every run and is passed with
# -e on the `podman run` command in RUNBOOK.md, not read from this file.
JOB_ID=local-test
CALLBACK_TOKEN=none
# Podman's alias for the host: the container's own localhost has no dev server
# on it. With nothing listening, status callbacks log a warning and the run
# continues.
BACKEND_URL=http://host.containers.internal:3000
FAST_TEST_MODE=false
