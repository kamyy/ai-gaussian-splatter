{
  "folders": [
    { "name": "frontend", "path": "frontend" },
    { "name": "backend", "path": "backend" },
    { "name": "worker", "path": "worker" },
    { "name": "infra", "path": "infra" },
    { "name": "docs", "path": "docs" },
    { "name": "root", "path": "." }
  ],
  "settings": {
    "search.exclude": {
      "**/node_modules": true,
      "**/.venv": true,
      "**/.next": true,
      "**/cdk.out": true,
      "**/dist": true,
      "**/__pycache__": true,
      "**/.mypy_cache": true,
      "**/.pytest_cache": true,
      "**/.ruff_cache": true,
      "**/*.tsbuildinfo": true
    },
    "files.exclude": {
      "frontend": true,
      "backend": true,
      "worker": true,
      "infra": true,
      "docs": true,
      "**/node_modules": true,
      "**/.venv": true,
      "**/.next": true,
      "**/cdk.out": true,
      "**/dist": true,
      "**/__pycache__": true,
      "**/.mypy_cache": true,
      "**/.pytest_cache": true,
      "**/.ruff_cache": true,
      "**/*.tsbuildinfo": true,
      "**/next-env.d.ts": true
    },
    "js/ts.tsdk.path": "frontend/node_modules/typescript/lib",
    "biome.enabled": false,
    "[typescript]": {
      "editor.defaultFormatter": "biomejs.biome",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": { "source.organizeImports.biome": "explicit" }
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "biomejs.biome",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": { "source.organizeImports.biome": "explicit" }
    },
    "[javascript]": {
      "editor.defaultFormatter": "biomejs.biome",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": { "source.organizeImports.biome": "explicit" }
    },
    "[json]": {
      "editor.defaultFormatter": "biomejs.biome",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": { "source.organizeImports.biome": "explicit" }
    }
  },
  "extensions": {
    "recommendations": ["biomejs.biome"]
  }
}
