{
  // Separate roots are what let each folder's own .vscode/settings.json actually apply. For example, infra and
  // worker each pick their own Python interpreter despite pinning the same Python version, since their .venv/
  // installs differ.
  "folders": [
    { "name": "web", "path": "web" },
    { "name": "worker", "path": "worker" },
    { "name": "infra", "path": "infra" },
    { "name": "scripts", "path": "scripts" },
    { "name": "root", "path": "." }
  ],
  "settings": {
    // Window-scoped, so these can't live in a folder's own settings.json.
    "explorer.sortOrder": "type",
    "js/ts.experimental.useTsgo": true,
    "js/ts.tsdk.path": "web/node_modules/typescript/lib",
    // Applies to every root folder, recursively
    "files.exclude": {
      "**/node_modules": true,
      "**/.venv": true,
      "**/.next": true,
      "**/cdk.out": true,
      "**/dist": true,
      "**/__pycache__": true,
      "**/.mypy_cache": true,
      "**/.pytest_cache": true,
      "**/.ruff_cache": true,
      "**/*.tsbuildinfo": true,
      "**/next-env.d.ts": true,
      "**/.claude": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/.venv": true,
      "**/.next": true,
      "**/cdk.out": true,
      "**/dist": true,
      "**/__pycache__": true,
      "**/.mypy_cache": true,
      "**/.pytest_cache": true,
      "**/.ruff_cache": true,
      "**/*.tsbuildinfo": true,
      "**/.claude": true
    },
    // Off for every folder by default, since the Biome VS Code extension runs one LSP session per folder with no
    // dedup and path "." nests the other four — leaving them all enabled would double up. .vscode/settings.json
    // overrides it back to true just for ".", whose single LSP session already covers the whole repo tree.
    "biome.enabled": false,
    //
    "[typescript]": {
      "editor.defaultFormatter": "biomejs.biome",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": { "source.organizeImports.biome": "explicit" }
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "biomejs.biome",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": { "source.organizeImports.biome": "explicit" }
    },
    "[javascript]": {
      "editor.defaultFormatter": "biomejs.biome",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": { "source.organizeImports.biome": "explicit" }
    },
    "[json]": {
      "editor.defaultFormatter": "biomejs.biome",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": { "source.organizeImports.biome": "explicit" }
    }
  },
  "extensions": {
    "recommendations": ["biomejs.biome", "charliermarsh.ruff", "ms-python.python", "ms-python.mypy-type-checker"]
  }
}
