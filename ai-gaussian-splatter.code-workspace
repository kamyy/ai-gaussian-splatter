{
  "folders": [
    { "name": "web", "path": "web" },
    { "name": "worker", "path": "worker" },
    { "name": "infra", "path": "infra" },
    { "name": "scripts", "path": "scripts" },
    { "name": "root", "path": "." }
  ],
  "settings": {
    "explorer.sortOrder": "type",
    "search.exclude": {
      "**/node_modules": true,
      "**/.venv": true,
      "**/.next": true,
      "**/cdk.out": true,
      "**/dist": true,
      "**/__pycache__": true,
      "**/.mypy_cache": true,
      "**/.pytest_cache": true,
      "**/.ruff_cache": true,
      "**/*.tsbuildinfo": true,
      "**/.claude": true
    },
    "files.exclude": {
      "web": true,
      "worker": true,
      "infra": true,
      "scripts": true,
      "**/node_modules": true,
      "**/.venv": true,
      "**/.next": true,
      "**/cdk.out": true,
      "**/dist": true,
      "**/__pycache__": true,
      "**/.mypy_cache": true,
      "**/.pytest_cache": true,
      "**/.ruff_cache": true,
      "**/*.tsbuildinfo": true,
      "**/next-env.d.ts": true,
      "**/.claude": true
    },
    "js/ts.tsdk.path": "web/node_modules/typescript/lib",
    "biome.enabled": false,
    "[typescript]": {
      "editor.defaultFormatter": "biomejs.biome",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": { "source.organizeImports.biome": "explicit" }
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "biomejs.biome",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": { "source.organizeImports.biome": "explicit" }
    },
    "[javascript]": {
      "editor.defaultFormatter": "biomejs.biome",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": { "source.organizeImports.biome": "explicit" }
    },
    "[json]": {
      "editor.defaultFormatter": "biomejs.biome",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": { "source.organizeImports.biome": "explicit" }
    }
  },
  "extensions": {
    "recommendations": ["biomejs.biome"]
  }
}
