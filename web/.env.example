# Local dev config for the web app. `scripts/dev/setup.sh aws` copies web/.env.example to web/.env when web/.env is
# missing, and never replaces an existing one. Fill in the Clerk keys. Read by web/lib/server/env.ts unless noted
# otherwise. EVAL_HOLDOUT is read by web/lib/server/workerLauncher.ts.

# The AWS region of the buckets below, and the one the credentials below are used in. web/lib/server/env.ts reads it,
# and the web app passes it to every S3 and EC2 client. A new web/.env is seeded from the default of var.aws_region in
# infra/variables.tf. That default can change later, so this value does not follow it.
#
# The worker container gets this value under a different name, AWS_DEFAULT_REGION, which
# web/lib/server/workerLauncher.ts sets. The worker's AWS library, boto3, reads only that name.
AWS_REGION=replace-with-aws-region

# The two dev buckets from "First-time setup" in RUNBOOK.md. One S3 bucket namespace spans every AWS account, so the
# account id is what keeps these names from colliding with someone else's.
UPLOADS_BUCKET=ai-gaussian-splatter-dev-uploads-replace-with-aws-account-id
SPLATS_BUCKET=ai-gaussian-splatter-dev-splats-replace-with-aws-account-id

# The dev IAM user scoped to those two buckets. `scripts/dev/setup.sh aws` writes its key pair here. Under `pnpm dev`
# every request that reads the environment fails while either key is unset or still a `replace-with-` placeholder, so
# the AWS SDK never falls back to ~/.aws/credentials.
AWS_ACCESS_KEY_ID=replace-with-dev-user-key
AWS_SECRET_ACCESS_KEY=replace-with-dev-user-secret

# Clerk. CLERK_SECRET_KEY also backs server-side session verification in web/lib/server/auth.ts and web/proxy.ts. Both
# keys are read directly off process.env by @clerk/nextjs, not through web/lib/server/env.ts.
# Use the Clerk development instance's keys here (pk_test_ / sk_test_). Never use the production instance's keys
# (pk_live_ / sk_live_).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Google Analytics 4 measurement ID (G-...). Leave it empty so local traffic isn't reported.
# If you set one, make it a test property's ID, never the production property's.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# A local-only switch for the train stage under `pnpm dev`. EVAL_HOLDOUT holds back every 8th photo, then logs PSNR and
# SSIM against them and writes side-by-side renders to worker/jobdir/<jobId>/eval/.
# EVAL_HOLDOUT=true

# Runtime settings. Production reads these from SSM Parameter Store instead (web/lib/server/runtimeSettings.ts), and
# each env var here is named after its setting. All optional. An unset one takes the default shown, and processing
# defaults to on.
#
# Set to false to pause processing. Reconstruct and train then refuse to start, and the app tells visitors why.
# PROCESSING_ENABLED=true
# The most GPU runs the whole site may start per day, shared by every user. Reconstruct and train both count.
# MAX_JOBS_PER_DAY=20
# The most photo-upload requests one IP address may make per hour. Each request is one batch of photos.
# UPLOADS_PER_IP_PER_HOUR=5
# The most photo-upload requests one user may make per day.
# UPLOADS_PER_USER_PER_DAY=3
# The fewest uploaded photos a splat needs before reconstruct will start.
# MIN_PHOTOS_PER_SPLAT=20
# The training steps the train stage runs, from 1000 to 30000. More steps take longer.
# TRAINING_ITERATIONS=10000

# The Clerk user ID (user_...) of the account whose complete, shareable splats the / landing page shows as examples.
# Leave it unset to show none.
# SHOWCASE_CLERK_USER_ID=
