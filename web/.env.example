# Clerk — CLERK_SECRET_KEY also backs server-side session verification.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Points Clerk at the embedded sign-in/sign-up pages under app/. Without these
# it redirects to its hosted Account Portal on accounts.dev instead.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Clerk telemetry is collected from development instances only. The NEXT_PUBLIC_
# variable is the one that matters — @clerk/nextjs reads it server-side and
# inlines it into the browser bundle; the unprefixed one reaches only the
# server-side collector.
CLERK_TELEMETRY_DISABLED=1
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1

# Postgres for local dev:
#   podman run -d --name splat-pg --restart=always \
#     -p 5432:5432 -v splat-pg-data:/var/lib/postgresql \
#     -e POSTGRES_USER=postgres \
#     -e POSTGRES_PASSWORD=test \
#     -e POSTGRES_DB=ai_gaussian_splatter postgres:18
#
# See docs/RUNBOOK.md for the volume mount path and boot-time restart setup.
#
# Split into parts rather than one URL, matching what ECS supplies in
# production: RDS stores its generated credentials as a JSON blob, and ECS
# cannot assemble a postgresql:// URL out of it itself. See
# lib/server/databaseUrl.ts.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ai_gaussian_splatter
DATABASE_USER=postgres
DATABASE_PASSWORD=test

# S3 — real buckets, not placeholder names. Presigning itself is a local HMAC
# and needs no AWS, but the browser PUTs photos directly to the presigned URL
# and the viewer fetches the .ply the same way, so both buckets must exist and
# carry a CORS rule for http://localhost:3000. See "Development AWS resources"
# in docs/RUNBOOK.md for creating them.
UPLOADS_BUCKET=ai-gaussian-splatter-dev-uploads
SPLATS_BUCKET=ai-gaussian-splatter-dev-splats
AWS_REGION=us-west-2

# The dev IAM user scoped to those two buckets — replace both. Kept here
# rather than in ~/.aws/credentials because `next dev` and the local container
# both load this file, and because the SDK's env provider tests these for
# truthiness: an empty value counts as absent and the chain falls through to
# ~/.aws/credentials, signing upload URLs with whatever profile is configured
# there. The placeholders are non-empty so an unedited .env fails with a 403
# instead of quietly using an admin profile.
AWS_ACCESS_KEY_ID=replace-with-dev-user-key
AWS_SECRET_ACCESS_KEY=replace-with-dev-user-secret

# GPU spot worker (see lib/server/ec2Launcher.ts)
WORKER_AMI_ID=
WORKER_INSTANCE_TYPE=g5.xlarge
WORKER_SUBNET_ID=
WORKER_SECURITY_GROUP_ID=
WORKER_INSTANCE_PROFILE_ARN=

# Abuse protection (plan §5) — all optional, defaults shown
RATE_LIMIT_IP_PER_HOUR=5
RATE_LIMIT_USER_PER_DAY=3
GLOBAL_MAX_JOBS_PER_DAY=20
MIN_PHOTOS_PER_OBJECT=20

# Where the worker PATCHes job status back to. Must be reachable from EC2.
APP_PUBLIC_URL=http://localhost:3000
