# Clerk (plan: @clerk/nextjs) — CLERK_SECRET_KEY also backs server-side
# session verification now, replacing the old backend's manual JWKS check.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Postgres. Local dev, e.g. (persistent volume + restart after reboot — see docs/RUNBOOK.md):
#   podman run -d --name splatter-pg --restart=always \
#     -p 5432:5432 -v splatter-pg-data:/var/lib/postgresql/data \
#     -e POSTGRES_USER=postgres \
#     -e POSTGRES_PASSWORD=test \
#     -e POSTGRES_DB=ai_gaussian_splatter postgres:18
#
#    systemctl --user enable --now podman-restart.service   # rootless Podman on Fedora
#
# Split into parts rather than one URL, matching what ECS supplies in
# production: RDS stores its generated credentials as a JSON blob, and ECS can
# only project individual fields of a secret into a variable. See
# lib/server/databaseUrl.ts.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ai_gaussian_splatter
DATABASE_USER=postgres
DATABASE_PASSWORD=test

# S3
UPLOADS_BUCKET=
SPLATS_BUCKET=
AWS_REGION=us-west-2

# GPU spot worker (see lib/server/ec2Launcher.ts)
WORKER_AMI_ID=
WORKER_INSTANCE_TYPE=g5.xlarge
WORKER_SUBNET_ID=
WORKER_SECURITY_GROUP_ID=
WORKER_INSTANCE_PROFILE_ARN=

# Abuse protection (plan §5) — all optional, defaults shown
RATE_LIMIT_IP_PER_HOUR=5
RATE_LIMIT_USER_PER_DAY=3
GLOBAL_MAX_JOBS_PER_DAY=20
MIN_PHOTOS_PER_OBJECT=20

# Where the worker PATCHes job status back to. Must be reachable from EC2.
APP_PUBLIC_URL=http://localhost:3000
