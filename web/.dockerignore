# Without this, the `COPY . .` in the builder stage overwrites the deps stage's
# cleanly-installed node_modules with the host's — which may hold packages built
# for a different platform — and bakes local .env files into an image layer.
node_modules
.next
.env
.env.*

# Tool state written into the working tree. `.clerk/.tmp/keyless.json` holds a
# Clerk development secret key, which `COPY . .` would put in a builder layer.
# It does not reach the final image — the runner stage copies only
# .next/standalone and .next/static — but it has no business in the build.
.clerk
.cursor

e2e
test
test-results
playwright-report
# `**/` is required: a bare `*.test.ts` matches root-level paths only, which
# leaves nested tests in the context while `test/` — holding the setup file
# their matcher types come from — is excluded, and `next build` type-checks
# them and fails.
**/*.test.ts
**/*.test.tsx

.git
.gitignore
Dockerfile
.dockerignore
README.md
AGENTS.md
CLAUDE.md
tsconfig.tsbuildinfo
