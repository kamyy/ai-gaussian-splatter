# An allowlist. Everything stays out of the build context except what's re-included below, so `COPY . .` in the builder
# stage can't sweep in local files. Those include .env files and other credentials, a database dump, the host's
# node_modules (which may hold packages built for another platform), and the Clerk development secret in
# .clerk/.tmp/keyless.json.
*

# Root-level source and config, by type rather than by name, so a Next.js convention file added later is picked up
# automatically. proxy.ts is one. Leaving it out would stop clerkMiddleware() from running, and the build would still
# pass.
!*.ts
!*.tsx
!*.mjs
!*.js
!package.json
!pnpm-lock.yaml
!tsconfig.json

# Whole directories. A new directory of code that isn't listed here fails the build loudly as soon as something imports
# it. A non-code file the app reads at runtime, outside these directories, needs its own line.
!app/
!components/
!lib/
!drizzle/
!scripts/
!public/

# Everything below is re-excluded after the allowlist above lets it back in. next-env.d.ts is generated, and next build
# writes its own.
next-env.d.ts
playwright.config.ts
# `**/` is required: a bare `*.test.ts` matches root-level paths only. That leaves nested tests in the context while
# tests/, holding the setup file their matcher types come from, stays out, and `next build` type-checks them and fails.
**/*.test.ts
**/*.test.tsx

# Credentials, at any depth, including inside the directories allowed above. Patterns match from the context root, not
# at every level the way .gitignore's do, so each needs the **/ prefix.
**/.env
**/.env.*
**/.npmrc
**/.aws/
**/.ssh/
**/id_rsa*
**/*.key
**/*.p12
# Local CA/certs (the RDS bundle is ADDed in the Dockerfile, not copied from the host).
**/*.pem
