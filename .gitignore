# Local data (photos, pipeline outputs)
worker/local_data/
worker/*.ply
worker/*.splat
# The bind mount and photo source in RUNBOOK.md's "Running the pipeline", both
# created in worker/. Path-anchored, so web/app/api/v1/splats/[splatId]/photos/
# stays tracked. worker/.dockerignore repeats them to keep them out of the
# build context.
worker/jobdir/
worker/photos/

# Logs
*.log

# Claude Code local scheduler state
.claude/scheduled_tasks.lock
