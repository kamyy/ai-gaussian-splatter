# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
# Only appears when pnpm cannot write to its usual ~/.local/share/pnpm location and relocates the store into the
# workspace, which sandboxed agent and container runs do.
.pnpm-store/
.next/
out/
dist/
build/
.turbo/

# Terraform
infra/**/.terraform/
infra/**/*.tfstate*
infra/**/crash.log*
infra/**/override.tf*
infra/**/*.tfvars
!infra/**/*.tfvars.example

# Env / secrets. web/.env.example is the committed template `scripts/dev/setup.sh aws` copies to web/.env.
.env
.env.*
!.env.example
*.pem

# Frontend (Vitest/Playwright output, Vercel CLI, TS incremental builds)
coverage/
test-results/
.vercel/
*.tsbuildinfo
next-env.d.ts

# OS / editor
.DS_Store
*.swp

# Local data (photos, pipeline outputs)
worker/local_data/
worker/*.ply
worker/*.splat
# Where web/lib/server/workerLauncher.ts mounts each local worker job's files. worker/.dockerignore repeats it to keep
# it out of the build context.
worker/jobdir/

# Logs
*.log

# Claude Code local scheduler state
.claude/scheduled_tasks.lock
