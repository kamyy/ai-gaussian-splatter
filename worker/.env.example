# Local dev config for the worker pipeline. Copy to worker/.env and fill in the placeholders. Read by
# pipeline/config.py.
#
# Loaded whole into the container by `podman run --env-file`, so keep WEB-only secrets out of it — see "Worker (local
# pipeline run)" in RUNBOOK.md for that command.

# The two dev buckets from "Dev AWS resources" in RUNBOOK.md.
UPLOADS_BUCKET=ai-gaussian-splatter-dev-uploads
SPLATS_BUCKET=ai-gaussian-splatter-dev-splats

# The dev IAM user scoped to the two buckets above, the same key pair web/.env.example carries.
AWS_ACCESS_KEY_ID=replace-with-dev-user-key
AWS_SECRET_ACCESS_KEY=replace-with-dev-user-secret

# The AWS region — the same value web/.env.example sets as AWS_REGION. It needs two names because boto3 reads only
# AWS_DEFAULT_REGION and the AWS SDK for JavaScript reads only AWS_REGION. RUNBOOK.md's local pipeline run exports
# this one so its `aws s3 sync` uploads to the same region.
AWS_DEFAULT_REGION=us-west-2

# Where the worker PATCHes job status back to. web/.env.example uses http://localhost:3000 instead: inside this
# container localhost is the container itself, and host.containers.internal is Podman's alias for the host running
# `next dev`. In production both are the same public hostname. With nothing listening, status callbacks log a
# warning and the run continues.
APP_PUBLIC_URL=http://host.containers.internal:3000

# SPLAT_ID is deliberately absent: it changes every run and is passed with -e on the `podman run` command in
# RUNBOOK.md, not read from this file.
JOB_ID=local-test
CALLBACK_TOKEN=none
FAST_TEST_MODE=false
