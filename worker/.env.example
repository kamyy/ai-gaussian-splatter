# Config for a local worker pipeline run. See "Worker (local pipeline run)" in
# RUNBOOK.md for the podman command that loads this with --env-file, and
# pipeline/config.py for the fields these populate. SPLAT_ID is deliberately
# absent: it changes every run and is passed with -e.
JOB_ID=local-test
CALLBACK_TOKEN=none
# Podman's alias for the host: the container's own localhost has no dev server on
# it. With nothing listening, status callbacks log a warning and the run continues.
BACKEND_URL=http://host.containers.internal:3000
FAST_TEST_MODE=true

# Buckets and the dev IAM user, shared with web/.env. AWS_DEFAULT_REGION rather
# than web's AWS_REGION — botocore reads only the former (RUNBOOK.md).
UPLOADS_BUCKET=ai-gaussian-splatter-dev-uploads
SPLATS_BUCKET=ai-gaussian-splatter-dev-splats
AWS_DEFAULT_REGION=us-west-2
AWS_ACCESS_KEY_ID=replace-with-dev-user-key
AWS_SECRET_ACCESS_KEY=replace-with-dev-user-secret
