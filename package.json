{
  "name": "ai-gaussian-splatter",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "prepare": "husky",
    "guard:cdk-context": "node scripts/check-cdk-context-account.ts",
    "format-staged": "biome check --write --staged --no-errors-on-unmatched && node scripts/format-python-staged.ts",
    "lint": "biome lint . && node scripts/lint-python.ts",
    "typecheck": "tsc --noEmit && pnpm --dir frontend exec tsc --noEmit && node scripts/typecheck-python.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^24",
    "husky": "^9.1.7",
    "typescript": "^6.0.3"
  }
}
